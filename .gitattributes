# WARNING: Do NOT modify this file.
# If there is a problem with it, submit a GitHub issue or pull request to fix it.

# Normalize text files to LF in Git and in cross-platform working trees.
* text=auto eol=lf

# Windows batch scripts use CRLF in the working tree.
*.bat text eol=crlf
*.cmd text eol=crlf

# Treat common binary document and archive files as binary.
*.7z   binary
*.docx binary
*.gz   binary
*.pdf  binary
*.pptx binary
*.tar  binary
*.xlsx binary
*.zip  binary

# Treat common binary image files as binary.
*.gif  binary
*.ico  binary
*.jpeg binary
*.jpg  binary
*.png  binary
*.webp binary

# Treat common AI, machine learning, and data science files as binary.
*.arrow       binary
*.feather     binary
*.h5          binary
*.hdf5        binary
*.joblib      binary
*.keras       binary
*.npy         binary
*.npz         binary
*.onnx        binary
*.parquet     binary
*.pickle      binary
*.pkl         binary
*.pt          binary
*.pth         binary
*.safetensors binary

# Treat common database files as binary.
# Database files should generally not be committed unless needed.
*.accdb   binary
*.bacpac  binary
*.bak     binary
*.bson    binary
*.dacpac  binary
*.db      binary
*.db3     binary
*.dbf     binary
*.duckdb  binary
*.fdb     binary
*.gdb     binary
*.ibd     binary
*.ldf     binary
*.mdb     binary
*.mdf     binary
*.myd     binary
*.myi     binary
*.rdb     binary
*.sqlite  binary
*.sqlite3 binary
