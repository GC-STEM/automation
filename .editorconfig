# GC-STEM automation repository EditorConfig
# https://editorconfig.org/
# Use LF for cross-platform text files; Windows batch files use CRLF.

root = true

# Common text-file settings
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

# Windows batch scripts
[*.{bat,cmd}]
end_of_line = crlf

# Python indentation
[*.py]
indent_size = 4

# Structured-data indentation
[*.{json,yaml,yml}]
indent_size = 2

# Preserve intentional Markdown trailing spaces
[*.md]
trim_trailing_whitespace = false
